APP_HOST=lig-kubdaisy.imag.fr

# ap-explanation image. The meteo questions need a release after v1.1.1; until it is
# published, build one from the ap-explanation repository and point at it:
#   docker build --target prod -t ap-explanation:local ../../ap-explanation
# AP_EXPLANATION_IMAGE=ap-explanation
# AP_EXPLANATION_TAG=local

# LLM used by ap-explanation to explain the provenance (OpenAI-compatible endpoint).
# Leave LLM_API_BASE empty to compute provenance without an explanation.
LLM_API_BASE=
LLM_API_KEY=
LLM_API_MODEL=
LLM_SSL_VERIFY=false
# LLM_TIMEOUT=300
