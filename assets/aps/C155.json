    {
      "id": "078bc405-5ae3-563b-8cee-495f2dedd1c8",
      "labels": [
        "Operator",
        "Provenance_SQL_Operator"
      ],
      "properties": {
        "name": "C155 SQL Query Operator",
        "description": "Show latitude and longitude of the highest wind speed in City of Zurich between 2018 and 2019",
        "command": "query",
        "queryType": "SELECT",
        "type": "SQL Query",
        "step": 1,
        "publishedDate": "2026-09-29",
        "startTime": "10:00:00",
        "query": "SELECT\n  w.latitude AS latitude,\n  w.longitude AS longitude,\n  w.windspeedmax AS max_wind_speed\nFROM meteo_windspeedmax AS w\nINNER JOIN meteo_elevation AS e\n  ON ROUND(CAST(w.latitude AS DECIMAL), 1) = ROUND(CAST(e.latitude AS DECIMAL), 1)\n  AND ROUND(CAST(w.longitude AS DECIMAL), 1) = ROUND(CAST(e.longitude AS DECIMAL), 1)\nWHERE\n  EXTRACT(YEAR FROM w.time) BETWEEN 2018 AND 2019\n  AND (ROUND(CAST(w.latitude AS DECIMAL), 1), ROUND(CAST(w.longitude AS DECIMAL), 1)) IN ((47.4, 8.5))\nORDER BY\n  w.windspeedmax DESC\nLIMIT 1"
      }
    },
