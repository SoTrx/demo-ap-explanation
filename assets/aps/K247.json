    {
      "id": "de6c53ee-9f03-5e15-9798-919610f44d09",
      "labels": [
        "Operator",
        "Provenance_SQL_Operator"
      ],
      "properties": {
        "name": "K247 SQL Query Operator",
        "description": "What are the counts of Frost Days (FD) in City of Zurich for each January between 2005 and 2015?",
        "command": "query",
        "queryType": "SELECT",
        "type": "SQL Query",
        "step": 1,
        "publishedDate": "2026-09-29",
        "startTime": "10:00:00",
        "query": "SELECT\n  COUNT(*) AS time_window_2,\n  mtn.latitude AS latitude,\n  mtn.longitude AS longitude,\n  EXTRACT(YEAR FROM mtn.time) AS time_window_3\nFROM meteo_tmin AS mtn\nWHERE\n  EXTRACT(YEAR FROM mtn.time) BETWEEN 2005 AND 2015\n  AND EXTRACT(MONTH FROM mtn.time) = 1\n  AND (\n    ROUND(CAST(mtn.latitude AS DECIMAL), 1),\n    ROUND(CAST(mtn.longitude AS DECIMAL), 1)\n  ) IN ((47.4, 8.5))\n  AND mtn.tmin - 273.15 < 0\nGROUP BY\n  mtn.latitude,\n  mtn.longitude,\n  EXTRACT(YEAR FROM mtn.time)"
      }
    },
    {
