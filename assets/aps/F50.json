    {
      "id": "b45b0d54-6538-5307-9d60-77cbaebd66bf",
      "labels": [
        "Operator",
        "Provenance_SQL_Operator"
      ],
      "properties": {
        "name": "F50 SQL Query Operator",
        "description": "Show the number of highest temperature readings in Celsius above 30 degrees in the City of Zurich in 2015.",
        "command": "query",
        "queryType": "SELECT",
        "type": "SQL Query",
        "step": 1,
        "publishedDate": "2026-09-29",
        "startTime": "10:00:00",
        "query": "SELECT\n  COUNT(*)\nFROM meteo_tmax AS mtx\nWHERE\n  mtx.tmax - 273.15 > 30\n  AND EXTRACT(YEAR FROM mtx.time) = 2015\n  AND (\n    ROUND(CAST(mtx.latitude AS DECIMAL), 1),\n    ROUND(CAST(mtx.longitude AS DECIMAL), 1)\n  ) IN ((47.4, 8.5))"
      }
    },
