    {
      "id": "98a06962-43f7-542b-a47e-bdc436e63e34",
      "labels": [
        "Operator",
        "Provenance_SQL_Operator"
      ],
      "properties": {
        "name": "G81 SQL Query Operator",
        "description": "List the top 10 lowest temperature readings (in celsius) in City of Zurich in July 2015 with their coordinates.",
        "command": "query",
        "queryType": "SELECT",
        "type": "SQL Query",
        "step": 1,
        "publishedDate": "2026-09-29",
        "startTime": "10:00:00",
        "query": "SELECT\n  mtn.latitude AS latitude,\n  mtn.longitude AS longitude,\n  mtn.tmin - 273.15 AS min_temp_in_celsius\nFROM meteo_tmin AS mtn\nWHERE\n  EXTRACT(MONTH FROM mtn.time) = 7\n  AND EXTRACT(YEAR FROM mtn.time) = 2015\n  AND (\n    ROUND(CAST(mtn.latitude AS DECIMAL), 1),\n    ROUND(CAST(mtn.longitude AS DECIMAL), 1)\n  ) IN ((47.4, 8.5))\nORDER BY\n  mtn.tmin ASC\nLIMIT 10"
      }
    },
    {
